{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tecnican Service Agent",
  "version": "0.1.0",
  "identifier": "com.twtech.tecnican.serviceagent",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' http: https:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Tecnican Service Agent",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Field service client for GLPI",
    "longDescription": "Tecnican desktop client for ticket queues, work sessions and service history.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
